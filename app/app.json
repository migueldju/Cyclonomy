{
  "expo": {
    "name": "Cyclonomy",
    "slug": "cyclonomy",
    "scheme": "cyclonomy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tuempresa.cyclonomy",
      "supportsTablet": false
    },
    "android": {
      "package": "com.tuempresa.cyclonomy",
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "backgroundColor": "#1E272C",
        "barStyle": "light-content"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4C63F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para la imagen de tu perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-horizontal.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      "expo-system-ui"
    ],
    "backgroundColor": "#1E272C",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
